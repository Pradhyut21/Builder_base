# Copy this file to .env and fill in your own local values:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials here.
# These only need to be "real" in the sense of being non-empty; for local
# dev/test containers any value works, since nothing outside your machine
# ever reads them.

QUEUESYNC_DEV_DB_PASSWORD=changeme_dev_db
QUEUESYNC_DEV_REDIS_PASSWORD=changeme_dev_redis
QUEUESYNC_TEST_DB_PASSWORD=changeme_test_db
QUEUESYNC_TEST_REDIS_PASSWORD=changeme_test_redis
